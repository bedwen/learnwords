{
  "name": "learnwords",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch --import tsx server/index.ts",
    "dev:server:lan": "node --watch --import tsx server/index.ts --lan",
    "dev:lan": "concurrently -n server,client -c blue,green \"npm:dev:server:lan\" \"npm:dev:client\"",
    "build": "tsc -b && vite build",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "better-sqlite3": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "lucide-react": "^1.55.0",
    "multer": "^2.4.0",
    "nanoid": "^5.0.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/multer": "^2.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "braces": "^3.0.3",
    "proxy-addr": "^2.0.8",
    "tinypool": "^2.2.0",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^7.1.6",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
