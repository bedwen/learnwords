# LearnWords Android Release Signing Configuration Template
#
# 1. Generate a persistent release keystore (run once from project root):
#    keytool -genkey -v -keystore android/app/release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias learnwords
#
# 2. Copy this file to android/keystore.properties (git-ignored) and fill in your credentials:
storeFile=release-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=learnwords
keyPassword=YOUR_KEY_PASSWORD
